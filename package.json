{
  "name": "sample-tlb",
  "version": "1.0.0",
  "description": "TL-B Runtime sample",
  "author": "Ilyar",
  "license": "MIT",
  "type": "module",
  "prettier": "@ton/toolchain/prettier",
  "scripts": {
    "gen:type": "node scripts/type-by-schema.mjs src/share/share.tlb",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "qa": "yarn lint && yarn test && yarn test:e2e",
    "dev": "vite",
    "build": "tsc && vite build --mode production && node scripts/render-preview.mjs",
    "release": "gh workflow run release.yml --ref main",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/generator": "^1.8.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@playwright/test": "^1.54.2",
    "@resvg/resvg-js": "^2.6.2",
    "@ton-community/tlb-runtime": "https://github.com/ilyar/tlb-runtime/releases/download/pr-7-42927ad/tlb-runtime-42927ad.tgz",
    "@ton/core": "^0.63.0",
    "@ton/toolchain": "the-ton-tech/toolchain#v1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "gh-pages": "^6.3.0",
    "highlight.js": "^11.11.1",
    "jest": "^30.0.5",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.46.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vscode-json-languageservice": "^6.0.0-next.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
